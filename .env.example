# --- Database (docker-compose.yml) ---
DATABASE_URL=postgres://tusky:tusky@localhost:5433/tusky

# --- API-Sports (https://dashboard.api-sports.io) ---
APISPORTS_KEY=
# Requests per day per sport API (free tier is 100; keep a safety margin)
APISPORTS_DAILY_BUDGET=90
# Gap between calls (free tier allows ~10 requests/minute)
APISPORTS_MIN_INTERVAL_MS=6500
# Comma-separated: football,basketball
ENABLED_SPORTS=football
# Only keep fixtures from these API-Sports league ids (comma-separated). Empty = ALL leagues worldwide,
# which will exhaust the free quota fast. Default: EPL, La Liga, Serie A, Bundesliga, Ligue 1, UCL / NBA.
FOOTBALL_LEAGUE_IDS=39,140,135,78,61,2
BASKETBALL_LEAGUE_IDS=12

# --- Cricket (fixtures/toss/live from CricketData.org; history from Cricsheet via `npm run cricket:import`) ---
# Add `cricket` to ENABLED_SPORTS to fetch cricket fixtures. Free tier ~100 hits/day.
CRICKETDATA_API_KEY=
CRICKETDATA_DAILY_BUDGET=90
# Keep only these formats (T20, ODI, Test). Empty = all.
CRICKET_FORMATS=

# --- Scheduler ---
FIXTURE_DAYS_AHEAD=2
FETCH_FIXTURES_CRON=0 */6 * * *
PROMOTE_LIVE_CRON=* * * * *
# Daily re-fetch of the last RESULTS_DAYS_BACK days so finished matches get final scores (ML labels)
SYNC_RESULTS_CRON=30 3 * * *
RESULTS_DAYS_BACK=2

# --- Scraper ---
HISTORY_STALE_DAYS=7
PLAYER_HISTORY_CONCURRENCY=2
MATCH_ENRICH_CONCURRENCY=1
# Max players per team to enrich via LLM (protects LLM/API budget). 0 = no limit.
MAX_PLAYERS_PER_TEAM=0

# --- LLM providers (Gemini primary -> Groq fallback -> Claude optional last) ---
GOOGLE_API_KEY=
LLM_GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
LLM_GROQ_MODEL=llama-3.3-70b-versatile
# Optional, used only as a last resort when set
ANTHROPIC_API_KEY=
LLM_CLAUDE_MODEL=claude-haiku-5-5

# --- Web search for player research (https://tavily.com) ---
TAVILY_API_KEY=

# --- ML service (ml-service/, Python) ---
# Sports to model (default: ENABLED_SPORTS)
ML_SPORTS=
# Predict scheduled matches starting within this many days
ML_PREDICT_DAYS_AHEAD=14
# `npm run ml:run` loop: predict every N minutes, retrain when the model is older than N days
ML_PREDICT_INTERVAL_MINUTES=60
ML_RETRAIN_DAYS=7
# Refuse to train on fewer usable completed matches than this
ML_MIN_TRAIN_MATCHES=300

LOG_LEVEL=info
