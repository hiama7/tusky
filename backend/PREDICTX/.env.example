# =============================================================================
# PREDICTX backend configuration. Copy to .env and fill in real values.
# NEVER commit .env. Secrets here must never be sent to the React app.
# =============================================================================
NODE_ENV=development
PORT=5000
# Public URL of the React app (used for CORS, cookies and password-reset links)
APP_URL=http://localhost:5173
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# --- Database (MySQL 8+, or MariaDB 10.6+ e.g. XAMPP) -----------------------
# Docker (docker compose up -d predictx-mysql):
#   mysql://predictx:predictx@127.0.0.1:3307/predictx
# XAMPP / local MySQL on the default port (create the user first — see README):
#   mysql://predictx:<password>@127.0.0.1:3306/predictx
DATABASE_URL=mysql://predictx:predictx@127.0.0.1:3307/predictx
# Used only by the automated tests (npm test). Must be a separate database whose name ends in _test.
TEST_DATABASE_URL=mysql://predictx:predictx@127.0.0.1:3307/predictx_test

# --- Auth --------------------------------------------------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_ADMIN_ACCESS_SECRET=change-me-too
# Encrypts admin two-factor secrets (32+ random characters). If empty, it is derived
# from JWT_ADMIN_ACCESS_SECRET, and changing that secret then resets two-factor.
ADMIN_2FA_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# --- First admin account (used by `npm run db:seed` / `npm run create-admin`) --
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Seed clearly-labelled sample sports, matches, predictions and news (development only)
SEED_DEMO_DATA=true

# Revenue reports group by local day; 330 = IST (UTC+5:30)
REPORT_TZ_OFFSET_MINUTES=330

# --- Razorpay (use TEST keys during development: rzp_test_...) ---------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Nodemailer SMTP). If SMTP_HOST is empty in development, emails are
# --- written to the server log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TUSKY <no-reply@example.com>"

# --- Uploads -----------------------------------------------------------------
UPLOAD_MAX_MB=2

# --- External data providers (optional, future) ------------------------------
SPORTS_DATA_PROVIDER=manual
SPORTS_DATA_API_KEY=
NEWS_PROVIDER=none
NEWS_API_KEY=

# --- ML predictions (TUSKY ml-service) --------------------------------------
# The ML service stores its predictions in the TUSKY Postgres (docker compose up -d postgres).
# Leave empty to disable. The backend only reads from it.
ML_DATABASE_URL=postgres://tusky:tusky@127.0.0.1:5433/tusky
# Price given to newly imported matches (admins can change it per match)
ML_PREDICTION_PRICE=49
ML_SYNC_DAYS=14
# Minutes between automatic syncs (0 = off). They import drafts unless ML_SYNC_PUBLISH=true.
ML_SYNC_INTERVAL_MINUTES=0
ML_SYNC_PUBLISH=false

# --- Optional data APIs -------------------------------------------------------
# League tables on match pages: free key from https://www.football-data.org
# (both keys may also be set in the project-root .env)
FOOTBALL_DATA_API_KEY=
# Sports headlines (Admin > News > Import): key from https://gnews.io
# The free GNews plan is for non-commercial use only.
GNEWS_API_KEY=

# --- Alerts --------------------------------------------------------------------
# Chat webhook that receives failures (may also be set in the project-root .env)
ALERT_WEBHOOK_URL=

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
