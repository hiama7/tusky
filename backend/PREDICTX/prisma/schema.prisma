// =============================================================================
// PREDICTX — MySQL schema (Prisma ORM 7)
//
// Conventions
//  * Money is DECIMAL(10,2) — never floating point.
//  * Probabilities are DECIMAL(5,2) percentages; the service layer checks they
//    total exactly 100 for the match's outcome format.
//  * `isDemo` marks clearly-labelled sample content created by the seed script.
//  * Entitlements (Purchase / FreeTrial / UserSubscription) are only ever created
//    by the server after verification — never from client input.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ----------------------------------------------------------------------------- enums

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  BLOCKED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum OutcomeFormat {
  TWO_WAY // team A or team B (cricket T20, tennis, basketball…)
  THREE_WAY // team A, team B or draw (football, hockey…)
}

enum MatchStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
  POSTPONED
}

enum PredictedOutcome {
  TEAM_A
  TEAM_B
  DRAW
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum PredictionStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum DataSource {
  MANUAL // entered by an administrator
  MODEL // generated by a prediction model (see modelVersion)
  PROVIDER // imported from an external data provider
}

enum PurchaseStatus {
  ACTIVE
  REVOKED // e.g. after a refund
}

enum TrialStatus {
  USED
  REVOKED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum TransactionType {
  PREDICTION
  SUBSCRIPTION
  WALLET_TOPUP
}

enum TransactionStatus {
  CREATED // order created, not paid
  CAPTURED // payment verified and captured
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum WalletEntryType {
  TOPUP
  PURCHASE
  REFUND
  ADJUSTMENT
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// ----------------------------------------------------------------------------- users & auth

model User {
  id              Int           @id @default(autoincrement())
  fullName        String        @db.VarChar(120)
  email           String        @unique @db.VarChar(191)
  phone           String?       @db.VarChar(20)
  passwordHash    String        @db.VarChar(255)
  role            Role          @default(USER)
  accountStatus   AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  // administrators' second factor (src/services/twoFactorService.js)
  totpSecret      String?       @db.VarChar(255) // encrypted
  totpEnabledAt   DateTime?
  totpLastStep    Int? // newest code accepted, so none is used twice
  totpRecovery    Json? // hashes of unused recovery codes
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  purchases           Purchase[]
  freeTrial           FreeTrial?
  subscriptions       UserSubscription[]
  transactions        Transaction[]
  walletEntries       WalletEntry[]
  notifications       Notification[]
  activities          ActivityLog[]
  favouriteSports     UserFavouriteSport[]
  adminLogs           AdminLog[]
  newsArticles        News[]
  predictionsCreated  Prediction[]         @relation("PredictionCreatedBy")
  predictionVersions  PredictionVersion[]
  refundsCreated      Refund[]

  @@index([role, accountStatus])
  @@index([createdAt])
  @@map("users")
}

/// Refresh tokens are stored as SHA-256 hashes. A `familyId` groups rotated
/// tokens so that re-use of a revoked token revokes the whole family.
model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique @db.Char(64)
  familyId   String    @db.Char(36)
  scope      String    @db.VarChar(10) // "user" | "admin"
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy Int?
  userAgent  String?   @db.VarChar(255)
  ip         String?   @db.VarChar(45)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ----------------------------------------------------------------------------- sports catalogue

model Sport {
  id            Int           @id @default(autoincrement())
  slug          String        @unique @db.VarChar(40)
  name          String        @unique @db.VarChar(60)
  description   String?       @db.VarChar(255)
  image         String?       @db.VarChar(255)
  color         String?       @db.VarChar(9)
  outcomeFormat OutcomeFormat @default(TWO_WAY)
  status        RecordStatus  @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  teams       Team[]
  tournaments Tournament[]
  matches     Match[]
  planAccess  PlanSportAccess[]
  favourites  UserFavouriteSport[]

  @@map("sports")
}

model Team {
  id        Int      @id @default(autoincrement())
  sportId   Int
  name      String   @db.VarChar(100)
  shortName String   @db.VarChar(5)
  logo      String?  @db.VarChar(255)
  color     String?  @db.VarChar(9)
  country   String?  @db.VarChar(60)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sport       Sport         @relation(fields: [sportId], references: [id], onDelete: Restrict)
  homeMatches Match[]       @relation("TeamA")
  awayMatches Match[]       @relation("TeamB")
  wins        MatchResult[]

  @@unique([sportId, name])
  @@map("teams")
}

model Tournament {
  id        Int          @id @default(autoincrement())
  sportId   Int
  name      String       @db.VarChar(120)
  season    String       @default("") @db.VarChar(20)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  sport   Sport   @relation(fields: [sportId], references: [id], onDelete: Restrict)
  matches Match[]

  @@unique([sportId, name, season])
  @@map("tournaments")
}

model Match {
  id              Int         @id @default(autoincrement())
  sportId         Int
  tournamentId    Int
  teamAId         Int
  teamBId         Int
  startsAt        DateTime // match date + time, stored in UTC
  venue           String      @db.VarChar(160)
  conditions      String?     @db.VarChar(255) // pitch / playing conditions
  image           String?     @db.VarChar(255)
  status          MatchStatus @default(UPCOMING)
  predictionPrice Decimal     @db.Decimal(10, 2)
  published       Boolean     @default(false)
  featured        Boolean     @default(false)
  archivedAt      DateTime?
  isDemo          Boolean     @default(false)
  externalId      String?     @unique @db.VarChar(60) // "ml:<id>" for matches imported from the ML service
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  sport        Sport          @relation(fields: [sportId], references: [id], onDelete: Restrict)
  tournament   Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  teamA        Team           @relation("TeamA", fields: [teamAId], references: [id], onDelete: Restrict)
  teamB        Team           @relation("TeamB", fields: [teamBId], references: [id], onDelete: Restrict)
  prediction   Prediction?
  result       MatchResult?
  purchases    Purchase[]
  freeTrials   FreeTrial[]
  transactions Transaction[]

  @@index([published, archivedAt, startsAt])
  @@index([sportId, startsAt])
  @@index([tournamentId])
  @@index([status])
  @@map("matches")
}

/// Actual outcome of a match (kept separate from predictions so model accuracy
/// can be evaluated against verified results).
model MatchResult {
  id               Int        @id @default(autoincrement())
  matchId          Int        @unique
  winningTeamId    Int?
  isDraw           Boolean    @default(false)
  scoreSummary     String?    @db.VarChar(120)
  resultDescription String    @db.VarChar(255)
  matchCompletedAt DateTime
  verifiedAt       DateTime?
  source           DataSource @default(MANUAL)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  match       Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  winningTeam Team? @relation(fields: [winningTeamId], references: [id], onDelete: SetNull)

  @@map("match_results")
}

// ----------------------------------------------------------------------------- predictions

/// The current prediction for a match. Every publish stores an immutable
/// snapshot in PredictionVersion for auditing and accuracy tracking.
model Prediction {
  id               Int              @id @default(autoincrement())
  matchId          Int              @unique
  outcomeFormat    OutcomeFormat
  teamAProbability Decimal          @db.Decimal(5, 2)
  teamBProbability Decimal          @db.Decimal(5, 2)
  drawProbability  Decimal?         @db.Decimal(5, 2)
  predictedOutcome PredictedOutcome
  confidenceLevel  ConfidenceLevel
  summary          String           @db.Text
  teamAnalysis     Json // { teamA: {strengths[], weaknesses[]}, teamB: {...} }
  recentForm       Json // { teamA: ["W","L",...], teamB: [...] }
  playerAnalysis   Json // [{ name, team: "A"|"B", stat, rating }]
  headToHead       Json // { played, aWins, bWins, draws }
  keyFactors       Json // ["...", ...]
  pitchAnalysis    String?          @db.Text
  weatherAnalysis  String?          @db.Text
  source           DataSource       @default(MANUAL)
  modelVersion     String?          @db.VarChar(60)
  publicationStatus PredictionStatus @default(DRAFT)
  version          Int              @default(0)
  publishedAt      DateTime?
  isDemo           Boolean          @default(false)
  createdById      Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  match     Match               @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdBy User?               @relation("PredictionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  versions  PredictionVersion[]
  purchases Purchase[]

  @@index([publicationStatus])
  @@map("predictions")
}

model PredictionVersion {
  id            Int      @id @default(autoincrement())
  predictionId  Int
  version       Int
  snapshot      Json
  publishedAt   DateTime @default(now())
  publishedById Int?

  prediction  Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  publishedBy User?      @relation(fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([predictionId, version])
  @@map("prediction_versions")
}

// ----------------------------------------------------------------------------- entitlements

/// One purchase entitlement per (user, match). Unique constraint prevents
/// duplicates even under concurrent payment verification.
model Purchase {
  id             Int            @id @default(autoincrement())
  userId         Int
  matchId        Int
  predictionId   Int?
  transactionId  Int            @unique
  amount         Decimal        @db.Decimal(10, 2)
  purchaseStatus PurchaseStatus @default(ACTIVE)
  purchasedAt    DateTime       @default(now())
  revokedAt      DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  match       Match       @relation(fields: [matchId], references: [id], onDelete: Restrict)
  prediction  Prediction? @relation(fields: [predictionId], references: [id], onDelete: SetNull)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([userId, matchId])
  @@index([matchId])
  @@map("purchases")
}

/// One free trial per account, enforced by the UNIQUE(user_id) constraint.
model FreeTrial {
  id          Int         @id @default(autoincrement())
  userId      Int         @unique
  matchId     Int
  activatedAt DateTime    @default(now())
  trialStatus TrialStatus @default(USED)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@index([matchId])
  @@map("free_trials")
}

model SubscriptionPlan {
  id           Int          @id @default(autoincrement())
  code         String       @unique @db.VarChar(40)
  planName     String       @db.VarChar(80)
  description  String?      @db.VarChar(255)
  price        Decimal      @db.Decimal(10, 2)
  durationDays Int
  features     Json // ["All predictions for 30 days", ...]
  allSports    Boolean      @default(true) // explicit access policy; false → see PlanSportAccess
  popular      Boolean      @default(false)
  sortOrder    Int          @default(0)
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sports        PlanSportAccess[]
  subscriptions UserSubscription[]
  transactions  Transaction[]

  @@map("subscription_plans")
}

/// Sports a plan unlocks when `allSports` is false.
model PlanSportAccess {
  planId  Int
  sportId Int

  plan  SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  sport Sport            @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([planId, sportId])
  @@map("plan_sport_access")
}

model UserSubscription {
  id                 Int                @id @default(autoincrement())
  userId             Int
  planId             Int
  transactionId      Int                @unique
  startDate          DateTime
  endDate            DateTime
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  transaction Transaction      @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([userId, subscriptionStatus, endDate])
  @@map("user_subscriptions")
}

// ----------------------------------------------------------------------------- payments

model Transaction {
  id                   Int               @id @default(autoincrement())
  transactionReference String            @unique @db.VarChar(40)
  userId               Int
  transactionType      TransactionType
  amount               Decimal           @db.Decimal(10, 2)
  currency             String            @default("INR") @db.Char(3)
  paymentStatus        TransactionStatus @default(CREATED)
  paymentMethod        String?           @db.VarChar(30) // upi, card, netbanking, wallet (Razorpay) or WALLET (internal)
  gatewayOrderId       String?           @unique @db.VarChar(64)
  gatewayPaymentId     String?           @unique @db.VarChar(64)
  matchId              Int?
  planId               Int?
  refundedAmount       Decimal           @default(0) @db.Decimal(10, 2)
  failureReason        String?           @db.VarChar(255)
  isDuplicate          Boolean           @default(false) // paid twice for an already-owned item; needs refund
  capturedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  match            Match?            @relation(fields: [matchId], references: [id], onDelete: SetNull)
  plan             SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  purchase         Purchase?
  userSubscription UserSubscription?
  refunds          Refund[]
  walletEntries    WalletEntry[]

  @@index([userId, createdAt])
  @@index([paymentStatus, capturedAt])
  @@index([transactionType, paymentStatus])
  @@map("transactions")
}

model Refund {
  id              Int          @id @default(autoincrement())
  transactionId   Int
  gatewayRefundId String?      @unique @db.VarChar(64)
  amount          Decimal      @db.Decimal(10, 2)
  reason          String?      @db.VarChar(255)
  refundStatus    RefundStatus @default(PENDING)
  createdById     Int?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([refundStatus, processedAt])
  @@map("refunds")
}

/// Razorpay webhook events already processed (idempotency).
model PaymentEvent {
  id          Int      @id @default(autoincrement())
  eventId     String   @unique @db.VarChar(64)
  eventType   String   @db.VarChar(60)
  payload     Json
  processedAt DateTime @default(now())

  @@map("payment_events")
}

/// Wallet balance = SUM(amount). Credits are positive, debits negative.
model WalletEntry {
  id            Int             @id @default(autoincrement())
  userId        Int
  entryType     WalletEntryType
  amount        Decimal         @db.Decimal(10, 2)
  transactionId Int?
  note          String?         @db.VarChar(255)
  createdAt     DateTime        @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("wallet_entries")
}

// ----------------------------------------------------------------------------- content & activity

model News {
  id                Int        @id @default(autoincrement())
  title             String     @db.VarChar(200)
  slug              String     @unique @db.VarChar(220)
  description       String     @db.VarChar(500)
  content           String     @db.Text
  image             String?    @db.VarChar(255)
  category          String     @db.VarChar(40)
  authorId          Int?
  publicationStatus NewsStatus @default(DRAFT)
  publishedAt       DateTime? // a future date schedules the article
  featured          Boolean    @default(false)
  trending          Boolean    @default(false)
  views             Int        @default(0)
  source            DataSource @default(MANUAL)
  externalId        String?    @db.VarChar(120)
  externalUrl       String?    @db.VarChar(500)
  isDemo            Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([source, externalId])
  @@index([publicationStatus, publishedAt])
  @@index([category])
  @@map("news")
}

model Notification {
  id               Int              @id @default(autoincrement())
  userId           Int
  title            String           @db.VarChar(150)
  message          String           @db.VarChar(500)
  notificationType NotificationType @default(INFO)
  isRead           Boolean          @default(false)
  createdAt        DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

/// User-facing activity timeline.
model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  kind        String   @db.VarChar(30) // account | purchase | trial | wallet | subscription
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activity_logs")
}

model UserFavouriteSport {
  userId  Int
  sportId Int

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([userId, sportId])
  @@map("user_favourite_sports")
}

model AdminLog {
  id          Int      @id @default(autoincrement())
  adminId     Int
  action      String   @db.VarChar(60)
  entityType  String?  @db.VarChar(40)
  entityId    String?  @db.VarChar(40)
  description String   @db.VarChar(500)
  ipAddress   String?  @db.VarChar(45)
  createdAt   DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@index([createdAt])
  @@map("admin_logs")
}
