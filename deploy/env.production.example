# Copy to deploy/.env.production on the server and fill in. Never commit that file.
# Generate secrets with:  openssl rand -hex 32

SITE_ADDRESS=example.com            # your domain, without https://
SITE_URL=https://example.com

MYSQL_PASSWORD=                     # letters and digits only (it goes inside a URL)
MYSQL_ROOT_PASSWORD=
POSTGRES_PASSWORD=                  # letters and digits only

JWT_ACCESS_SECRET=                  # 32+ random characters
JWT_ADMIN_ACCESS_SECRET=            # a different one
ADMIN_2FA_KEY=                      # another; keep a copy somewhere safe

# Mail (required for password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TUSKY <no-reply@example.com>"

# Payments: test keys (rzp_test_...) until Razorpay has approved the business
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional
FOOTBALL_DATA_API_KEY=
GNEWS_API_KEY=
ALERT_WEBHOOK_URL=
JOBS_PUBLISH=false
