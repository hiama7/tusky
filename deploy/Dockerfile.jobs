# The daily run and backups: Node for the site scripts, Python for the models.
FROM node:24-bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl python3 python3-venv libgomp1 mariadb-client postgresql-client ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/PREDICTX/package.json backend/PREDICTX/package-lock.json backend/PREDICTX/
RUN cd backend/PREDICTX && npm ci
COPY ml-service/requirements.txt ml-service/
RUN python3 -m venv ml-service/.venv && ml-service/.venv/bin/pip install --no-cache-dir -r ml-service/requirements.txt
COPY backend/PREDICTX/ backend/PREDICTX/
COPY ml-service/ ml-service/
COPY ops/ ops/
COPY deploy/scheduler.sh deploy/
RUN cd backend/PREDICTX && DATABASE_URL=mysql://build:build@localhost:3306/build npx prisma generate
ENV NODE_ENV=production
CMD ["sh", "deploy/scheduler.sh"]
