# {$SITE_ADDRESS} is your domain (HTTPS is automatic), or ":80" for a local trial.
{$SITE_ADDRESS} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Razorpay Checkout and Google Fonts are the only outside sources
		Content-Security-Policy "default-src 'self'; script-src 'self' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.razorpay.com; frame-src https://api.razorpay.com https://checkout.razorpay.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:5000
	}
	handle /uploads/* {
		reverse_proxy api:5000
	}
	handle {
		root * /srv
		# built files carry a hash in their name, so browsers may keep them
		@hashed path_regexp ^/assets/.+-[A-Za-z0-9_-]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# every page address is answered by the app
		try_files {path} /index.html
		file_server
	}
}
